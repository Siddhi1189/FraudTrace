# FraudTrace Frontend Environment Variables
# In development, leave both blank to use the Vite dev proxy to http://localhost:5000.

# Backend API base URL (origin only, without /api suffix, e.g., https://fraudtrace-api.onrender.com)
VITE_API_BASE_URL=

# Backend Socket.IO connection URL (origin only, e.g., https://fraudtrace-api.onrender.com)
VITE_SOCKET_URL=
