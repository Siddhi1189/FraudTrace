# Node execution environment (development | production)
NODE_ENV=production

# Server HTTP and WebSocket port (assigned by Render in production)
PORT=5000

# MongoDB connection string URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fraudtrace?retryWrites=true&w=majority

# Secret key used for signing and verifying JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# JWT authentication token lifetime duration
JWT_EXPIRY=24h

# Comma-separated list of allowed frontend origins without trailing slashes
CORS_ORIGINS=https://your-frontend.vercel.app

# Optional Google Gemini API key for AI Copilot (leave blank for deterministic fallback)
GEMINI_API_KEY=

# Optional Gemini model identifier
LLM_MODEL=gemini-1.5-flash

# Seed analyst user full name (used by scripts/seed.js)
SEED_ANALYST_NAME=Analyst User

# Seed analyst email address (used by scripts/seed.js)
SEED_ANALYST_EMAIL=analyst@fraudtrace.local

# Seed analyst password (used by scripts/seed.js, min 8 chars)
SEED_ANALYST_PASSWORD=Password123!

# Seed administrator full name (used by scripts/seed.js)
SEED_ADMIN_NAME=Admin User

# Seed administrator email address (used by scripts/seed.js)
SEED_ADMIN_EMAIL=admin@fraudtrace.local

# Seed administrator password (used by scripts/seed.js, min 8 chars)
SEED_ADMIN_PASSWORD=AdminPassword123!
